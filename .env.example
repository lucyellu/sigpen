# Path to the local data store (Parquet files + SQLite). Defaults to ./data.
SIGPEN_DATA_DIR=./data

# Override poll intervals (seconds). Defaults are baked into each source.
# SIGPEN_GOES_XRAYS_POLL=60

# Disable the in-process scheduler (useful for tests or read-only review).
# SIGPEN_DISABLE_SCHEDULER=0
